@startuml
title Диаграмма Компонентов - Экосистема умного дома (SaaS)

!include https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(apiGateway, "API Gateway (Kong)") {
    Component(authPlugin, "Плагин аутентификации", "Kong Plugin", "Проверка токенов")
    Component(rateLimitPlugin, "Плагин лимитирования запросов", "Kong Plugin", "Управление частотой запросов")
}

Container_Boundary(smartControlService, "Сервис управления устройствами (Node.js)") {
    Component(controlLogic, "Логика управления", "Node.js", "Обработка команд управления устройствами")
    Component(apiHandler, "Обработчик API", "Express.js", "Маршрутизация API-запросов")
    Component(cacheIntegration, "Кеш интеграция", "Redis Client", "Доступ к кешу управления устройствами")
}

Container_Boundary(deviceIntegrationService, "Сервис интеграции устройств (Java)") {
    Component(protocolHandler, "Обработчик протоколов", "Java", "Работа с протоколами устройств")
    Component(apiHandler, "Обработчик API", "Spring Boot", "Маршрутизация API-запросов")
    Component(cacheIntegration, "Кеш интеграция", "Redis Client", "Доступ к кешу интеграции устройств")
}

Container_Boundary(notificationService, "Сервис уведомлений (Python)") {
    Component(notificationLogic, "Логика уведомлений", "Flask", "Обработка и отправка уведомлений")
    Component(apiHandler, "Обработчик API", "Flask", "Маршрутизация API-запросов")
}

Container_Boundary(userRegistrationService, "Сервис регистрации пользователя (Go)") {
    Component(userLogic, "Логика пользователя", "Go", "Управление регистрацией и учетными записями")
    Component(apiHandler, "Обработчик API", "Go HTTP", "Маршрутизация API-запросов")
    Component(cacheIntegration, "Кеш интеграция", "Redis Client", "Доступ к кешу регистрации пользователей")
}

Container_Boundary(deviceRegistrationService, "Сервис регистрации устройства (Kotlin)") {
    Component(deviceLogic, "Логика устройства", "Kotlin", "Управление регистрацией устройств")
    Component(apiHandler, "Обработчик API", "Ktor", "Маршрутизация API-запросов")
    Component(cacheIntegration, "Кеш интеграция", "Redis Client", "Доступ к кешу регистрации устройств")
}

Container_Boundary(databaseSmartControl, "База данных управления устройствами (Postgres)")

Container_Boundary(databaseDeviceIntegration, "База данных интеграции устройств (MongoDB)")

Container_Boundary(databaseNotification, "База данных уведомлений (MongoDB)")

Container_Boundary(databaseUser, "База данных пользователей (Postgres)")

Container_Boundary(databaseDevice, "База данных устройств (MongoDB)")

Container_Boundary(messageQueue, "Очередь сообщений (RabbitMQ)")

System_Ext(internet, "Интернет", "Связь для удаленного доступа к устройствам")

System_Ext(partnerDevices, "Устройства партнеров", "Соблюдение стандартных протоколов")

Rel(apiGateway, smartControlService, "API-запросы")
Rel(apiGateway, deviceIntegrationService, "API-запросы")
Rel(apiGateway, notificationService, "API-запросы")
Rel(apiGateway, userRegistrationService, "API-запросы")
Rel(apiGateway, deviceRegistrationService, "API-запросы")

Rel(smartControlService, cacheIntegration, "Чтение/Запись кэшированых данных")
Rel(deviceIntegrationService, cacheIntegration, "Чтение/Запись кэшированых данных")
Rel(userRegistrationService, cacheIntegration, "Чтение/Запись кэшированых данных")
Rel(deviceRegistrationService, cacheIntegration, "Чтение/Запись кэшированых данных")

Rel(smartControlService, messageQueue, "Асинхронные команды и сообщения")
Rel(deviceIntegrationService, messageQueue, "Асинхронные обновления телеметрии")

Rel(smartControlService, databaseSmartControl, "Чтение/Запись данных управления")
Rel(deviceIntegrationService, databaseDeviceIntegration, "Чтение/Запись конфигураций и телеметрии")
Rel(notificationService, databaseNotification, "Чтение/Запись уведомлений и журналов")
Rel(userRegistrationService, databaseUser, "Чтение/Запись данных пользователей")
Rel(deviceRegistrationService, databaseDevice, "Чтение/Запись данных устройств")

Rel(deviceIntegrationService, partnerDevices, "Интеграция через стандартные протоколы")
Rel(partnerDevices, internet, "Подключение к интернету")

Rel(notificationService, apiGateway, "Уведомления и обновления статуса")
Rel(notificationService, messageQueue, "Обработка и отправка уведомлений")

@enduml
